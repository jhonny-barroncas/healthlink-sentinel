NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://healthlink:healthlink_dev@localhost:5432/healthlink
REDIS_URL=redis://localhost:6379
JWT_SECRET=substitua-por-um-segredo-com-no-minimo-32-caracteres
ZABBIX_CREDENTIALS_ENCRYPTION_KEY=substitua-por-uma-chave-de-32-bytes
ZABBIX_API_URL=http://10.0.0.37/zabbix/api_jsonrpc.php
ZABBIX_API_TOKEN=cole-o-token-localmente-e-nao-versione-este-arquivo
ZABBIX_SYNC_INTERVAL_MS=60000
ZABBIX_TELEMETRY_INTERVAL_MS=2000

# Agente local Starlink (configuração da unidade; não preencher com segredos no repositório)
HEALTHLINK_API_URL=http://localhost:3000
HEALTHLINK_API_TOKEN=
HEALTHLINK_API_EMAIL=
HEALTHLINK_API_PASSWORD=
HEALTHLINK_TENANT_ID=
HEALTHLINK_EQUIPMENT_ID=
STARLINK_HOST=192.168.100.1
STARLINK_PORT=9200
STARLINK_POLL_INTERVAL_MS=15000
STARLINK_TIMEOUT_MS=3000
STARLINK_QUEUE_PATH=.healthlink-starlink-queue.json
